<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>

    <!-- DLL filename setting -->
    <AssemblyName>DuckTracks</AssemblyName>

    <!-- Mod name setting (Ducky SDK required) -->
    <ModName>DuckTracks</ModName>

    <!-- Build setting: do not treat warnings as errors -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>

    <!-- AssemblyInfo.cs를 수동으로 관리하므로 자동 생성 비활성화 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ducky.Sdk" Version="0.1.5" />
    <PackageReference Include="Lib.Harmony" Version="2.4.1" />
  </ItemGroup>

  <!--
    Harmony는 설정 창이 떠 있는 동안 플레이어 입력을 막는 데만 씁니다.

    0Harmony.dll을 모드 폴더에 직접 넣어야 합니다. NuGet 참조는 기본적으로 bin에
    복사되지 않고, Ducky SDK의 CopyToDuckov는 모드 폴더를 지운 뒤 모드 DLL·pdb·에셋만
    다시 넣습니다. 그냥 두면 배포된 모드 옆에 0Harmony.dll이 없고, Harmony 타입을 가진
    클래스는 로드 자체가 실패해서 패치가 조용히 하나도 안 걸립니다. 다른 모드가 먼저
    같은 버전을 올려 줬다면 우연히 동작하지만, 그건 로드 순서에 기댄 것입니다.

    버전이 반드시 일치해야 합니다. 참조가 2.4.1.0으로 박혀 있어서 2.4.2를 넣으면
    똑같이 로드에 실패합니다.

    반드시 lib/ 쪽(실제 구현, 약 2.4MB)을 집어야 합니다. @(ReferencePath)로 가져오면
    참조 전용 어셈블리(약 99KB)가 잡히는데, 버전이 똑같아서 겉으로는 구분이 안 되고
    런타임에만 같은 방식으로 로드에 실패합니다.

    빌드 출력 폴더에는 넣지 않습니다. SDK가 출력 폴더의 여분 DLL을 ILRepack으로
    합치려 들고(ilrepack 도구가 없으면 빌드가 깨집니다) Dependency 폴더에도 중복으로
    복사합니다.
  -->
  <Target Name="ResolveHarmonyAssembly">
    <ItemGroup>
      <_HarmonyPackageRef Include="@(PackageReference)" Condition="'%(Identity)' == 'Lib.Harmony'" />
    </ItemGroup>
    <PropertyGroup>
      <_HarmonyVersion>@(_HarmonyPackageRef->'%(Version)')</_HarmonyVersion>
      <_HarmonyRuntimeDll>$(NuGetPackageRoot)lib.harmony\$(_HarmonyVersion)\lib\net472\0Harmony.dll</_HarmonyRuntimeDll>
    </PropertyGroup>
    <ItemGroup>
      <HarmonyAssembly Include="$(_HarmonyRuntimeDll)" Condition="Exists('$(_HarmonyRuntimeDll)')" />
    </ItemGroup>
    <Warning Condition="!Exists('$(_HarmonyRuntimeDll)')"
             Text="0Harmony 런타임 어셈블리를 찾지 못했습니다: $(_HarmonyRuntimeDll). 배포된 모드에서 패치가 동작하지 않습니다." />
  </Target>

  <!-- CopyToDuckov가 모드 폴더를 지우고 다시 만들기 때문에 반드시 그 뒤에 넣어야 합니다. -->
  <Target Name="CopyHarmonyToDuckov" AfterTargets="CopyToDuckov"
          DependsOnTargets="ResolveHarmonyAssembly"
          Condition=" '$(DuckovFolder)' != '' AND '$(ModName)' != '' AND '$(DeployMod)' != 'false' ">
    <Copy SourceFiles="@(HarmonyAssembly)"
          DestinationFolder="$(ModsDirectory)$(ModName)/"
          SkipUnchangedFiles="false" />
    <Message Text="[DuckTracks] 0Harmony.dll ($(_HarmonyVersion)) -> $(ModsDirectory)$(ModName)/" Importance="high" />
  </Target>

</Project>
